{
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "files.associations": {
        "*.js": "javascript"
    },
    "editor.rulers": [
        100
    ],
    "code-runner.ignoreSelection": true,
    "eslint.enable": false,
    "javascript.diagnostics.unusedParameters": "ignore",
    "javascript.diagnostics.unusedLocalVariables": "ignore",
    "editor.showUnused": false
}